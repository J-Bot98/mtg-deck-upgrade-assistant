# Database
DATABASE_URL=sqlite+aiosqlite:///./data/mtg.db

# Scryfall API
SCRYFALL_API_BASE_URL=https://api.scryfall.com

# App
LOG_LEVEL=INFO
DEBUG=false

# AI Provider API Keys (opzionale — inserisci solo il provider che usi)
# Le chiavi vengono passate dal frontend, non servono qui per l'uso base.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# External data sources (read-only, no key required)
# EDHREC JSON API: https://json.edhrec.com  (used by Commander Decks page)
# Scryfall batch API: https://api.scryfall.com/cards/collection  (used for card enrichment)
