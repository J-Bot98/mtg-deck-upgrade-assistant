# Database
DATABASE_URL=sqlite+aiosqlite:///./data/mtg.db

# Scryfall API
SCRYFALL_API_BASE_URL=https://api.scryfall.com

# App
LOG_LEVEL=INFO
DEBUG=false

# AI Provider API Keys (opzionale — inserisci solo il provider che usi)
# Le chiavi vengono passate dal frontend, non servono qui per l'uso base.
# Puoi però impostarle qui come default server-side se preferisci.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
